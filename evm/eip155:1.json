cat > tests/test_scanner.py <<'EOF'
from backend.app.scanner import (
    scan_url, scan_transaction, enforce_strict_policy
)

def test_http_url_blocked():
    assert scan_url("http://example.com")["allowed"] is False

def test_incomplete_transaction_blocked():
    assert scan_transaction({})["allowed"] is False

def test_unverified_contract_blocked():
    tx = {
        "wallet": "0x123",
        "chain": "ethereum",
        "to": "0x456",
        "value": "1",
        "simulation_ok": True,
        "contract_verified": False,
        "recipient_blocked": False
    }
    assert scan_transaction(tx)["allowed"] is False

def test_ai_unknown_blocks():
    local = {"allowed": True}
    ai = {"risk": "unknown"}
    assert enforce_strict_policy(local, ai)["allowed"] is False

def test_ai_low_allows_only_after_local_pass():
    local = {"allowed": True}
    ai = {"risk": "low"}
    assert enforce_strict_policy(local, ai)["allowed"] is True
EOF

