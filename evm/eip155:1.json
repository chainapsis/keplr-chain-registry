cat > backend/app/security.py <<'EOF'
import os
import secrets
from fastapi import Header, HTTPException

def require_admin(authorization: str = Header(default="")):
    expected = os.getenv("ADMIN_TOKEN", "")
    if not expected:
        raise HTTPException(503, "ADMIN_TOKEN belum dikonfigurasi")
    supplied = authorization.removeprefix("Bearer ").strip()
    if not secrets.compare_digest(supplied, expected):
        raise HTTPException(401, "Unauthorized")
    return True
EOF

cat > backend/app/ai_engine.py <<'EOF'
import json
from openai import OpenAI
from .config import settings

def analyze_with_ai(payload: dict) -> dict:
    if not settings.API_KEY:
        return {
            "available": False,
            "assessment": "AI tidak dikonfigurasi",
            "risk": "unknown"
        }

    client = OpenAI(api_key=settings.API_KEY)

    response = client.chat.completions.create(
        model=settings.MODEL,
        temperature=0,
        messages=[
            {
                "role": "system",
                "content": (
                    "You are a wallet security analyst. "
                    "Analyze transaction metadata only. "
                    "Never request seed phrases or private keys. "
                    "Return JSON with risk (low, medium, high, unknown) "
                    "and explanation. Treat unverified information as unknown."
                )
            },
            {
                "role": "user",
                "content": json.dumps(payload)
            }
        ],
        response_format={"type": "json_object"}
    )

    return json.loads(response.choices[0].message.content)
EOF

cat > backend/app/scanner.py <<'EOF'
from urllib.parse import urlparse

BLOCKED_DOMAINS = {
    "wallet-drainer.example",
    "fake-airdrop.example",
}

def scan_url(url: str) -> dict:
    try:
        parsed = urlparse(url)
        if parsed.scheme != "https" or not parsed.hostname:
            return {
                "allowed": False,
                "risk": "high",
                "reason": "URL harus menggunakan HTTPS dan host yang valid"
            }

        host = parsed.hostname.lower().rstrip(".")
        if host in BLOCKED_DOMAINS:
            return {
                "allowed": False,
                "risk": "high",
                "reason": "Domain masuk daftar blokir"
            }

        return {
            "allowed": True,
            "risk": "unknown",
            "reason": "Tidak ditemukan kecocokan daftar blokir lokal"
        }
    except Exception:
        return {
            "allowed": False,
            "risk": "high",
            "reason": "URL tidak dapat diperiksa"
        }

def scan_transaction(tx: dict) -> dict:
    required = ["wallet", "chain", "to", "value"]
    if any(not tx.get(field) for field in required):
        return {
            "allowed": False,
            "risk": "high",
            "reason": "Metadata transaksi tidak lengkap"
        }

    if tx.get("chain") not in ("ethereum", "polygon", "cosmos", "osmosis"):
        return {
            "allowed": False,
            "risk": "high",
            "reason": "Jaringan belum didukung"
        }

    if tx.get("simulation_ok") is not True:
        return {
            "allowed": False,
            "risk": "unknown",
            "reason": "Simulasi transaksi belum berhasil"
        }

    if tx.get("contract_verified") is not True:
        return {
            "allowed": False,
            "risk": "high",
            "reason": "Kontrak belum diverifikasi"
        }

    if tx.get("recipient_blocked") is True:
        return {
            "allowed": False,
            "risk": "high",
            "reason": "Penerima masuk daftar blokir"
        }

    return {
        "allowed": True,
        "risk": "low",
        "reason": "Pemeriksaan aturan lokal berhasil"
    }

def enforce_strict_policy(local: dict, ai: dict | None = None) -> dict:
    ai = ai or {}
    if not local.get("allowed"):
        return {"allowed": False, "reason": local.get("reason")}

    # AI tidak boleh membatalkan keputusan blokir dari aturan lokal.
    if ai.get("risk") in ("high", "unknown"):
        return {
            "allowed": False,
            "reason": "AI tidak dapat memastikan transaksi aman"
        }

    if ai.get("risk") == "medium":
        return {
            "allowed": False,
            "reason": "Risiko menengah diblokir oleh kebijakan strict"
        }

    if ai.get("risk") != "low":
        return {
            "allowed": False,
            "reason": "Hasil analisis AI tidak valid atau tidak tersedia"
        }

    return {"allowed": True, "reason": "Lolos pemeriksaan lokal dan AI"}
EOF

cat > backend/app/main.py <<'EOF'
import sqlite3
from contextlib import asynccontextmanager
from fastapi import FastAPI, Depends, HTTPException
from pydantic import BaseModel, Field
from .config import settings
from .security import require_admin
from .scanner import scan_url, scan_transaction, enforce_strict_policy
from .ai_engine import analyze_with_ai

def init_db():
    conn = sqlite3.connect(settings.DATABASE_PATH)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS events (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            event_type TEXT NOT NULL,
            result TEXT NOT NULL,
            reason TEXT NOT NULL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    conn.close()

def log_event(event_type: str, result: str, reason: str):
    conn = sqlite3.connect(settings.DATABASE_PATH)
    conn.execute(
        "INSERT INTO events(event_type,result,reason) VALUES(?,?,?)",
        (event_type, result, reason)
    )
    conn.commit()
    conn.close()

@asynccontextmanager
async def lifespan(app: FastAPI):
    init_db()
    yield

app = FastAPI(
    title=settings.APP_NAME,
    version="1.0.0",
    lifespan=lifespan
)

class URLRequest(BaseModel):
    url: str = Field(min_length=8, max_length=2048)

class TransactionRequest(BaseModel):
    wallet: str = Field(min_length=3, max_length=128)
    chain: str
    to: str = Field(min_length=3, max_length=128)
    value: str
    simulation_ok: bool = False
    contract_verified: bool = False
    recipient_blocked: bool = False

@app.get("/health")
def health():
    return {"status": "ok", "service": settings.APP_NAME}

@app.get("/")
def root():
    return {"message": settings.APP_NAME, "dashboard": "/dashboard"}

@app.get("/dashboard")
def dashboard():
    from fastapi.responses import HTMLResponse
    with open("frontend/index.html", encoding="utf-8") as f:
        return HTMLResponse(f.read())

@app.post("/api/scan/url")
def url_scan(data: URLRequest, _: bool = Depends(require_admin)):
    result = scan_url(data.url)
    log_event("url", "allowed" if result["allowed"] else "blocked",
              result["reason"])
    return result

@app.post("/api/scan/transaction")
def transaction_scan(data: TransactionRequest,
                     _: bool = Depends(require_admin)):
    payload = data.model_dump()
    local = scan_transaction(payload)

    if not local["allowed"]:
        final = {"allowed": False, "reason": local["reason"]}
    else:
        try:
            ai = analyze_with_ai(payload)
            final = enforce_strict_policy(local, ai)
        except Exception:
            final = {
                "allowed": False,
                "reason": "Analisis AI gagal; kebijakan fail-closed aktif"
            }

    log_event(
        "transaction",
        "allowed" if final["allowed"] else "blocked",
        final["reason"]
    )
    return final

@app.get("/api/events")
def events(_: bool = Depends(require_admin)):
    conn = sqlite3.connect(settings.DATABASE_PATH)
    rows = conn.execute(
        "SELECT id,event_type,result,reason,created_at "
        "FROM events ORDER BY id DESC LIMIT 100"
    ).fetchall()
    conn.close()

    return [
        {
            "id": r[0], "type": r[1], "result": r[2],
            "reason": r[3], "created_at": r[4]
        } for r in rows
    ]
EOF

